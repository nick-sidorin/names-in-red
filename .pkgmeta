# CurseForge's GitHub source packager.
package-as: NamesInRed
enable-nolib-creation: no

ignore:
  - AGENTS.md
  - CHANGELOG.md
  - PROJECT_CONTEXT.md
  - README.md
  - idea.md
  - docs
  - scripts
  - tests

move-folders:
  NamesInRed/NamesInRed: NamesInRed

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
